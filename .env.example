# Docker Compose overrides. Development defaults only; never deploy these secrets.
# Copy to .env beside docker-compose.yml (do not commit the populated .env).
NODE_ENV=development
POSTGRES_DB=glowbook_db
POSTGRES_USER=glowbook
POSTGRES_PASSWORD=glowbook_local
JWT_SECRET=local-development-access-secret-change-in-production
JWT_REFRESH_SECRET=local-development-refresh-secret-change-in-production
WEB_PORT=8080
# FRONTEND_URL and CORS_ORIGINS follow WEB_PORT unless explicitly overridden.
# FRONTEND_URL=https://beautybook.example
# CORS_ORIGINS=https://beautybook.example

# Optional: provide DATABASE_URL when using an external database or a password
# containing URL-reserved characters. Percent-encode credentials in that URL.
# DATABASE_URL=postgresql://user:encoded-password@postgres:5432/database?schema=public
# REDIS_URL=redis://redis:6379
