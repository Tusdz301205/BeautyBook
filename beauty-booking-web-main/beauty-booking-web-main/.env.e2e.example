PW_EXISTING_BOOKING_ID=

# JSON array of at least 10 isolated customer credentials for race tests.
PW_CONCURRENCY_CUSTOMERS_JSON=
# A known-free payload in the dedicated test database.
PW_BOOKING_PAYLOAD_JSON=
# Prefer four distinct free-slot payloads so every core concurrency case is
# independent. PW_BOOKING_PAYLOAD_JSON remains the single-payload fallback.
PW_BOOKING_PAYLOADS_JSON=
# Optional prepared race specifications; see concurrency test helper.
PW_RACE_CUSTOMER_RECEPTIONIST_JSON=
PW_RACE_MULTI_SERVICE_ONE_STAFF_JSON=
PW_RACE_MULTI_SERVICE_MANY_STAFF_JSON=
