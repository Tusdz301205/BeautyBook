**/.agents/
**/playwright-report/
**/test-results/
**/playwright/.auth/
**/uploads/

# The Compose frontend is the nested application. The outer Vite starter is
# a local reference, not part of the deployed BeautyBook application.
/beauty-booking-web-main/*
!/beauty-booking-web-main/beauty-booking-web-main/
