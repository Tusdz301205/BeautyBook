# Runtime and editor files
*.log
*.tmp
*.temp
*.bak
*.orig
*.swp
*.swo
*.pid
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local AI/document tooling and external reference repositories.
# These stay available on the developer machine but are not part of BeautyBook.
.codex-docx-qa*/
skills/
tools/

# Personal or generated office documents are not source code.
docs/*.docx

# Local exports, generated reports and temporary QA artifacts.
/tmp/
/output/
/report-output/
**/report-output/
/.report-edit/
mobile-preview/artifacts/
/mobile-preview/
/docs/full-system-qa/
/docs/generated-images/beautybook/originals/
/docs/generated-images/beautybook/qa-*
