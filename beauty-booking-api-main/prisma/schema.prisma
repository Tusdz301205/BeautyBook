  media     MediaFile             @relation(fields: [mediaId], references: [id])
  service   BranchServiceOffering @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_images")
}

model ComboImage {
  id        String    @id @default(uuid())
  comboId   String    @map("combo_id")
