}

/// Immutable price evidence captured when a booking is created. Service prices
/// may change later without rewriting this snapshot.
model PricingSnapshot {
  id             String   @id @default(uuid())
  bookingId      String   @unique @map("booking_id")
  businessId     String   @map("business_id")
  branchId       String   @map("branch_id")
  currency       String   @default("VND")
  subtotalAmount Decimal  @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  finalAmount    Decimal  @map("final_amount") @db.Decimal(12, 2)
  items          Json
  capturedAt     DateTime @default(now()) @map("captured_at")
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  business       Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([businessId, capturedAt])
  @@index([branchId, capturedAt])
  @@map("pricing_snapshots")
}

model PaymentPolicy {
  id                String                  @id @default(uuid())
  businessId        String                  @map("business_id")
  branchId          String?                 @map("branch_id")
  serviceId         String?                 @map("service_id")
  name              String
  version           Int
  status            PolicyVersionStatus     @default(ACTIVE)
