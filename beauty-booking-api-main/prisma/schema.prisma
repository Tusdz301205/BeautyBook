model ServiceCategory {
  id               String                  @id @default(uuid())
  businessId       String                  @map("business_id")
  parentId         String?                 @map("parent_id")
  name             String
  slug             String
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  deletedAt        DateTime?               @map("deleted_at")
  business         Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent           ServiceCategory?        @relation("CategoryTree", fields: [parentId], references: [id])
  children         ServiceCategory[]       @relation("CategoryTree")
  services         BranchServiceOffering[]
  businessServices BusinessService[]

  @@unique([businessId, slug])
  @@index([businessId, deletedAt])
  @@index([parentId])
  @@map("service_categories")
}

/// Platform-owned taxonomy used only for normalization, search and analytics.
/// It is never booked or sold directly by a salon.
model CanonicalService {
  id                     String                 @id @default(uuid())
  code                   String                 @unique
  slug                   String                 @unique
  name                   String
  description            String?
  parentId               String?                @map("parent_id")
  replacementCanonicalId String?                @map("replacement_canonical_id")
  synonyms               String[]               @default([])
  status                 CanonicalServiceStatus @default(ACTIVE)
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  parent                 CanonicalService?      @relation("CanonicalTree", fields: [parentId], references: [id])
  children               CanonicalService[]     @relation("CanonicalTree")
  replacement            CanonicalService?      @relation("CanonicalReplacement", fields: [replacementCanonicalId], references: [id])
  replacedCanonicals     CanonicalService[]     @relation("CanonicalReplacement")
  businessServices       BusinessService[]
  bookingServices        BookingService[]

  @@index([parentId])
  @@index([replacementCanonicalId])
  @@index([status, name])
  @@map("canonical_services")
}

/// Business-level service definition. Existing branch offering rows remain the
/// branch-level availability/override records referenced by booking history.
model BusinessService {
  id                  String                  @id @default(uuid())
  businessId          String                  @map("business_id")
  categoryId          String                  @map("category_id")
  canonicalServiceId  String?                 @map("canonical_service_id")
  name                String
  description         String?
  keywords            String[]                @default([])
  mappingStatus       ServiceMappingStatus    @default(UNMAPPED) @map("mapping_status")
  basePrice           Decimal                 @map("base_price") @db.Decimal(12, 2)
  baseDurationMinutes Int                     @map("base_duration_minutes")
  status              ServiceStatus           @default(ACTIVE)
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  deletedAt           DateTime?               @map("deleted_at")
  business            Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category            ServiceCategory         @relation(fields: [categoryId], references: [id])
  canonicalService    CanonicalService?       @relation(fields: [canonicalServiceId], references: [id], onDelete: Restrict)
  branchServices      BranchServiceOffering[]
  bookingServices     BookingService[]

  @@index([businessId, status, deletedAt])
  @@index([categoryId])
  @@index([canonicalServiceId, mappingStatus])
  @@map("business_services")
}

/// Concrete service sold by one exact branch. The underlying table remains
/// `services` so every historical foreign key and ID is preserved.
model BranchServiceOffering {
  id                        String                          @id @default(uuid())
  branchId                  String                          @map("branch_id")
  businessServiceId         String                          @map("business_service_id")
  categoryId                String                          @map("category_id")
  name                      String
  description               String?
  price                     Decimal                         @db.Decimal(12, 2)
  durationMinutes           Int                             @map("duration_minutes")
  bookable                  Boolean                         @default(true)
  status                    ServiceStatus                   @default(ACTIVE)
  createdAt                 DateTime                        @default(now()) @map("created_at")
  updatedAt                 DateTime                        @updatedAt @map("updated_at")
  deletedAt                 DateTime?                       @map("deleted_at")
  bookingServices           BookingService[]
  comboServices             ComboService[]
  promotionLinks            PromotionService[]
  images                    ServiceImage[]
  branch                    Branch                          @relation(fields: [branchId], references: [id])
  businessService           BusinessService                 @relation(fields: [businessServiceId], references: [id])
  category                  ServiceCategory                 @relation(fields: [categoryId], references: [id])
  staffServices             StaffService[]
  consultationRequirement   ServiceConsultationRequirement?
  consultationSubmissions   ConsultationSubmission[]
  consultationConsentEvents ConsentEvent[]
  paymentPolicies           PaymentPolicy[]
  savedByCustomers          CustomerSavedService[]
  voucherScopes             VoucherServiceScope[]

  @@unique([branchId, businessServiceId])
  @@index([branchId])
  @@index([businessServiceId])
  @@index([categoryId])
  @@index([status])
  @@index([branchId, status, deletedAt, createdAt])
  @@index([price])
  @@map("services")
}

model StaffService {
  staffId   String                @map("staff_id")
  serviceId String                @map("service_id")
  createdAt DateTime              @default(now()) @map("created_at")
  service   BranchServiceOffering @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff     StaffProfile          @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([serviceId])
  @@map("staff_services")
}

model Combo {
  id                  String                   @id @default(uuid())
  businessId          String                   @map("business_id")
  branchId            String                   @map("branch_id")
  name                String
  description         String?
  comboPrice          Decimal                  @map("combo_price") @db.Decimal(12, 2)
  validFrom           DateTime?                @map("valid_from")
  validTo             DateTime?                @map("valid_to")
  maxUsage            Int?                     @map("max_usage")
  usedCount           Int                      @default(0) @map("used_count")
  status              ComboStatus              @default(ACTIVE)
  pricingMode         ComboPricingMode         @default(FIXED_PRICE) @map("pricing_mode")
  staffAssignmentMode ComboStaffAssignmentMode @default(SINGLE_PROVIDER) @map("staff_assignment_mode")
  version             Int                      @default(1)
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  deletedAt           DateTime?                @map("deleted_at")
  bookingServices     BookingService[]
  images              ComboImage[]
  comboServices       ComboService[]
  business            Business                 @relation(fields: [businessId], references: [id])
  branch              Branch                   @relation(fields: [branchId], references: [id])
  promotionLinks      PromotionCombo[]
  recurringPlans      RecurringBookingPlan[]
  voucherScopes       VoucherComboScope[]

  @@index([branchId])
  @@index([businessId, status])
  @@index([status])
  @@map("combos")
}

model ComboService {
  comboId           String                @map("combo_id")
  serviceId         String                @map("service_id")
  quantity          Int                   @default(1)
  sortOrder         Int                   @default(0) @map("sort_order")
  priceSnapshot     Decimal               @map("price_snapshot") @db.Decimal(12, 2)
  durationSnapshot  Int                   @map("duration_snapshot")
  transitionMinutes Int                   @default(0) @map("transition_minutes")
  combo             Combo                 @relation(fields: [comboId], references: [id], onDelete: Cascade)
  service           BranchServiceOffering @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([comboId, serviceId])
  @@index([serviceId])
  @@index([comboId, sortOrder])
  @@map("combo_services")
}

model Promotion {
  id                  String              @id @default(uuid())
  name                String
  description         String?
  discountType        DiscountType        @map("discount_type")
  discountValue       Decimal             @map("discount_value") @db.Decimal(12, 2)
  startDate           DateTime            @map("start_date")
  endDate             DateTime            @map("end_date")
  status              PromotionStatus     @default(ACTIVE)
