  branch            Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  paymentPolicy     PaymentPolicy? @relation(fields: [paymentPolicyId], references: [id], onDelete: SetNull)

  @@index([businessId, capturedAt])
  @@map("payment_policy_snapshots")
}

model PaymentIntent {
  id                   String               @id @default(uuid())
  bookingId            String?              @map("booking_id")
  packagePurchaseId    String?              @map("package_purchase_id")
  packageInstallmentId String?              @map("package_installment_id")
  businessId           String               @map("business_id")
  branchId             String               @map("branch_id")
  amount               Decimal              @db.Decimal(12, 2)
  currency             String               @default("VND")
  method               PaymentMethod
  provider             String
  status               PaymentIntentStatus  @default(CREATED)
  idempotencyKey       String               @unique @map("idempotency_key")
  expiresAt            DateTime?            @map("expires_at")
  metadata             Json?
  createdBy            String               @map("created_by")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  booking              Booking?             @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  packagePurchase      PackagePurchase?     @relation(fields: [packagePurchaseId], references: [id], onDelete: Restrict)
  packageInstallment   PackageInstallment?  @relation(fields: [packageInstallmentId], references: [id], onDelete: Restrict)
  business             Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
