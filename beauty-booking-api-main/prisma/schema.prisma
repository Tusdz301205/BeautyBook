/// Append-only earnings ledger. Historical entries keep a complete rule and
/// basis snapshot so later rule edits cannot change past compensation.
model CompensationEntry {
  id                    String                   @id @default(uuid())
  businessId            String                   @map("business_id")
  branchId              String                   @map("branch_id")
  staffId               String                   @map("staff_id")
  timesheetId           String?                  @map("timesheet_id")
  bookingServiceId      String?                  @map("booking_service_id")
  ruleId                String?                  @map("rule_id")
  payRunItemId          String?                  @map("pay_run_item_id")
  originalEntryId       String?                  @map("original_entry_id")
  type                  CompensationEntryType
  status                CompensationEntryStatus  @default(EARNED)
  amount                Decimal                  @db.Decimal(12, 2)
  currency              String                   @default("VND")
  calculationBasis      String                   @map("calculation_basis")
  calculationSnapshot   Json                     @map("calculation_snapshot")
  sourceType            String                   @map("source_type")
  sourceId              String                   @map("source_id")
  dedupeKey             String                   @unique @map("dedupe_key")
  earnedAt              DateTime                 @map("earned_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  business              Business                 @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch                Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  staff                 StaffProfile             @relation(fields: [staffId], references: [id], onDelete: Restrict)
  timesheet             Timesheet?               @relation(fields: [timesheetId], references: [id], onDelete: Restrict)
  bookingService        BookingService?          @relation(fields: [bookingServiceId], references: [id], onDelete: Restrict)
  rule                  CompensationRule?        @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  payRunItem            PayRunItem?              @relation(fields: [payRunItemId], references: [id], onDelete: Restrict)
  originalEntry         CompensationEntry?       @relation("CompensationEntryReversal", fields: [originalEntryId], references: [id], onDelete: Restrict)
  reversingEntries      CompensationEntry[]      @relation("CompensationEntryReversal")
  adjustmentsAsOriginal CompensationAdjustment[] @relation("CompensationAdjustmentOriginal")
  adjustmentsAsResult   CompensationAdjustment[] @relation("CompensationAdjustmentResult")

  @@index([staffId, earnedAt, status])
  @@index([businessId, earnedAt, type])
  @@index([branchId, earnedAt])
  @@index([sourceType, sourceId])
  @@map("compensation_entries")
}

