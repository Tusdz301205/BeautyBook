generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                       @id @default(uuid())
  email                    String                       @unique
  phone                    String?                      @unique
  passwordHash             String                       @map("password_hash")
  fullName                 String                       @map("full_name")
  address                  String?
  avatarMediaId            String?                      @map("avatar_media_id")
  gender                   Gender?
  dateOfBirth              DateTime?                    @map("date_of_birth") @db.Date
  isEmailVerified          Boolean                      @default(false) @map("is_email_verified")
  isPhoneVerified          Boolean                      @default(false) @map("is_phone_verified")
  isActive                 Boolean                      @default(true) @map("is_active")
  lastLoginAt              DateTime?                    @map("last_login_at")
  createdAt                DateTime                     @default(now()) @map("created_at")
  updatedAt                DateTime                     @updatedAt @map("updated_at")
  deletedAt                DateTime?                    @map("deleted_at")
  changeRequestsRequested  AppointmentChangeRequest[]   @relation("ChangeRequestRequestedBy")
  changeRequestsReviewed   AppointmentChangeRequest[]   @relation("ChangeRequestReviewedBy")
  auditLogs                AuditLog[]
  statusChanges            BookingStatusHistory[]       @relation("StatusChangedBy")
  cancelledBookings        Booking[]                    @relation("BookingCancelledBy")
  ownerProfile             BusinessOwnerProfile?
  customerProfile          CustomerProfile?
  deviceTokens             DeviceToken[]
  uploadedMedia            MediaFile[]                  @relation("MediaUploader")
  notifications            Notification[]
  notificationOutboxes     NotificationOutbox[]
  salonMemberships         SalonMember[]
  staffProfile             StaffProfile?
  userRolesGranted         UserRole[]                   @relation("UserRoleGrantor")
  userRoles                UserRole[]
  avatarMedia              MediaFile?                   @relation("UserAvatar", fields: [avatarMediaId], references: [id])
  accountTokens            AccountToken[]
  sessions                 UserSession[]
  attendanceRecords        StaffAttendance[]            @relation("AttendanceUser")
  attendanceAdjustments    StaffAttendance[]            @relation("AttendanceAdjustedBy")
  attendanceExceptions     AttendanceExceptionRequest[] @relation("AttendanceExceptionRequester")
  attendanceReviews        AttendanceExceptionRequest[] @relation("AttendanceExceptionReviewer")
  attendanceAbsences       StaffAttendance[]            @relation("AttendanceAbsentMarker")
  attendanceQrTokens       AttendanceQrToken[]          @relation("AttendanceQrTokenCreator")
  attendanceQrUses         AttendanceQrUse[]            @relation("AttendanceQrUser")
  attendanceEvents         AttendanceEvent[]            @relation("AttendanceEventActor")
  trustActions             TrustAction[]                @relation("TrustActionActor")
  businessReviewEvents     BusinessReviewEvent[]        @relation("BusinessReviewActor")
  businessDocumentVersions BusinessDocumentVersion[]    @relation("BusinessDocumentVersionCreator")
  documentReviewEvents     DocumentReviewEvent[]        @relation("DocumentReviewActor")
  branchDocumentVersions   BranchDocumentVersion[]      @relation("BranchDocumentVersionCreator")
  branchReviewEvents       BranchReviewEvent[]          @relation("BranchReviewActor")
  branchReviewRequests     BranchReviewRequest[]        @relation("BranchReviewRequester")
  branchReviewAssignments  BranchReviewRequest[]        @relation("BranchReviewReviewer")
  staffScheduleVersions    StaffScheduleVersion[]       @relation("StaffScheduleVersionCreator")
  scheduleChangeRequests   StaffScheduleChangeRequest[] @relation("ScheduleChangeRequester")
  scheduleChangeReviews    StaffScheduleChangeRequest[] @relation("ScheduleChangeReviewer")
  userPermissions          UserPermission[]
  reviewReports            ReviewReport[]               @relation("ReviewReporter")

  @@index([email])
  @@index([phone])
  @@map("users")
}

model AccountToken {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      AccountTokenType
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at")
  usedAt    DateTime?        @map("used_at")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("account_tokens")
}

model UserSession {
  id               String        @id @default(uuid())
  userId           String        @map("user_id")
  refreshTokenHash String?       @map("refresh_token_hash")
  userAgent        String?       @map("user_agent")
  ipAddress        String?       @map("ip_address")
  workspace        AuthWorkspace @default(CUSTOMER)
  businessId       String?       @map("business_id")
  branchId         String?       @map("branch_id")
  lastActiveAt     DateTime      @default(now()) @map("last_active_at")
  expiresAt        DateTime      @map("expires_at")
  revokedAt        DateTime?     @map("revoked_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([userId, workspace, businessId, branchId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model StaffInvitation {
  id             String           @id @default(uuid())
  email          String
  roleCode       RoleCode         @map("role_code")
  businessId     String           @map("business_id")
  branchId       String?          @map("branch_id")
  staffProfileId String?          @map("staff_profile_id")
  tokenHash      String           @unique @map("token_hash")
  status         InvitationStatus @default(PENDING)
  invitedBy      String           @map("invited_by")
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  acceptedBy     String?          @map("accepted_by")
  revokedAt      DateTime?        @map("revoked_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  staffProfile   StaffProfile?    @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)

  @@index([email, status])
  @@index([businessId, branchId])
  @@index([staffProfileId, status])
  @@map("staff_invitations")
}

model Role {
  id              String           @id @default(uuid())
  code            RoleCode         @unique
  name            String
  createdAt       DateTime         @default(now()) @map("created_at")
  level           RoleLevel        @default(CUSTOMER)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  description     String?
  resource        String
  action          String
  scope           PermissionScope  @default(SELF)
  createdAt       DateTime         @default(now()) @map("created_at")
  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  permissionId String     @map("permission_id")
  bundleCode   String?    @map("bundle_code")
  grantedBy    String?    @map("granted_by")
  grantedAt    DateTime   @default(now()) @map("granted_at")
  expiresAt    DateTime?  @map("expires_at")
  revokedAt    DateTime?  @map("revoked_at")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId, revokedAt, expiresAt])
  @@index([permissionId])
  @@map("user_permissions")
}

/// Junction table carrying the SCOPE of a role assignment.
/// - businessId (== "tenant" trong plan): null = platform role
/// - branchId: null when the role applies to all branches of the tenant
/// - expiresAt: optional expiry (e.g. seasonal staff)
/// - grantedBy: audit-friendly attribution
model UserRole {
  userId     String    @map("user_id")
  roleId     String    @map("role_id")
  branchId   String?   @map("branch_id")
  businessId String?   @map("business_id")
  expiresAt  DateTime? @map("expires_at")
  grantedAt  DateTime  @default(now()) @map("granted_at")
  grantedBy  String?   @map("granted_by")
  id         String    @id @default(uuid())
  branch     Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  grantor    User?     @relation("UserRoleGrantor", fields: [grantedBy], references: [id])
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, businessId, branchId])
  @@index([userId])
  @@index([roleId])
  @@index([businessId])
  @@index([branchId])
  @@map("user_roles")
}

model CustomerProfile {
  id                      String                      @id @default(uuid())
  userId                  String                      @unique @map("user_id")
  address                 String?
  note                    String?
  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime                    @updatedAt @map("updated_at")
  deletedAt               DateTime?                   @map("deleted_at")
  healthRecords           BookingHealthRecord[]
  bookings                Booking[]
  comments                BusinessComment[]
  user                    User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerVouchers        CustomerVoucher[]
  recurringPlans          RecurringBookingPlan[]
  reviews                 Review[]
  consents                SensitiveConsent[]
  consultationSubmissions ConsultationSubmission[]
  consentEvents           ConsentEvent[]
  dataSubjectRequests     DataSubjectRequest[]
  marketingPreference     MarketingPreference?
  privacyExportPackages   PrivacyExportPackage[]
  packagePurchases        PackagePurchase[]
  savedServices           CustomerSavedService[]
  invoiceRequests         InvoiceInformationRequest[]

  @@map("customer_profiles")
}

/// Immutable contact snapshot for a guest or walk-in booking. A phone number
/// here is contact data only; it never proves ownership of a registered User.
model BookingContact {
  id        String   @id @default(uuid())
  bookingId String   @unique @map("booking_id")
  fullName  String   @map("full_name")
  phone     String?
  email     String?
  createdAt DateTime @default(now()) @map("created_at")
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@map("booking_contacts")
}

model BusinessOwnerProfile {
  id                 String     @id @default(uuid())
  userId             String     @unique @map("user_id")
  companyName        String?    @map("company_name")
  taxCode            String?    @unique @map("tax_code")
  identityCardNumber String?    @map("identity_card_number")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  deletedAt          DateTime?  @map("deleted_at")
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  businesses         Business[]

  @@map("business_owner_profiles")
}

model StaffProfile {
  id                      String                       @id @default(uuid())
  userId                  String?                      @unique @map("user_id")
  branchId                String                       @map("branch_id")
  fullName                String                       @map("full_name")
  position                String?
  bio                     String?
  employeeCode            String?                      @map("employee_code")
  experienceYears         Int?                         @map("experience_years")
  publicVisible           Boolean                      @default(true) @map("public_visible")
  isBookable              Boolean                      @default(false) @map("is_bookable")
  emergencyContactName    String?                      @map("emergency_contact_name")
  emergencyContactPhone   String?                      @map("emergency_contact_phone")
  status                  StaffStatus                  @default(ACTIVE)
  hiredAt                 DateTime?                    @map("hired_at") @db.Date
  createdAt               DateTime                     @default(now()) @map("created_at")
  updatedAt               DateTime                     @updatedAt @map("updated_at")
  deletedAt               DateTime?                    @map("deleted_at")
  changeRequests          AppointmentChangeRequest[]   @relation("ChangeRequestProposedStaff")
  bookingServices         BookingService[]
  reviewRatings           ReviewServiceRating[]
  images                  StaffImage[]
  branch                  Branch                       @relation(fields: [branchId], references: [id])
  user                    User?                        @relation(fields: [userId], references: [id])
  staffServices           StaffService[]
  workingHours            StaffWorkingHour[]
  breaks                  StaffBreak[]
  leaves                  StaffLeave[]
  specialDays             SpecialWorkingDay[]
  attendances             StaffAttendance[]
  attendanceExceptions    AttendanceExceptionRequest[]
  attendanceQrUses        AttendanceQrUse[]
  attendanceEvents        AttendanceEvent[]
  recurringPlans          RecurringBookingPlan[]
  branchAssignments       StaffBranchAssignment[]
  scheduleVersions        StaffScheduleVersion[]
  scheduleChangeRequests  StaffScheduleChangeRequest[]
  availabilities          StaffAvailability[]
  timesheets              Timesheet[]
  compensationAssignments CompensationAssignment[]
  compensationEntries     CompensationEntry[]
  payRunItems             PayRunItem[]
  invitations             StaffInvitation[]

  @@unique([branchId, employeeCode])
  @@index([branchId])
  @@index([status])
  @@index([branchId, status, isBookable, publicVisible])
  @@map("staff_profiles")
}

model DeviceToken {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  token     String         @unique
  platform  DevicePlatform
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model Province {
  id        String     @id @default(uuid())
  name      String     @unique
  code      String?    @unique
  createdAt DateTime   @default(now()) @map("created_at")
  districts District[]

  @@map("provinces")
}

model District {
  id         String   @id @default(uuid())
  provinceId String   @map("province_id")
  name       String
  code       String?
  createdAt  DateTime @default(now()) @map("created_at")
  branches   Branch[]
  province   Province @relation(fields: [provinceId], references: [id])

  @@unique([provinceId, name])
  @@index([provinceId])
  @@map("districts")
}

model Business {
  id                        String                       @id @default(uuid())
  ownerId                   String                       @map("owner_id")
  name                      String
  slug                      String                       @unique
  description               String?
  contactEmail              String?                      @map("contact_email")
  contactPhone              String?                      @map("contact_phone")
  addressLine               String?                      @map("address_line")
  legalRepresentative       String?                      @map("legal_representative")
  legalDocuments            Json?                        @map("legal_documents")
  onboardingData            Json?                        @map("onboarding_data")
  onboardingStep            Int                          @default(1) @map("onboarding_step")
  marketplacePreviewedAt    DateTime?                    @map("marketplace_previewed_at")
  reviewNote                String?                      @map("review_note")
  submittedAt               DateTime?                    @map("submitted_at")
  reviewedAt                DateTime?                    @map("reviewed_at")
  logoMediaId               String?                      @map("logo_media_id")
  status                    BusinessStatus               @default(PENDING)
  createdAt                 DateTime                     @default(now()) @map("created_at")
  updatedAt                 DateTime                     @updatedAt @map("updated_at")
  deletedAt                 DateTime?                    @map("deleted_at")
  branches                  Branch[]
  comments                  BusinessComment[]
  images                    BusinessImage[]
  logoMedia                 MediaFile?                   @relation("BusinessLogo", fields: [logoMediaId], references: [id])
  owner                     BusinessOwnerProfile         @relation(fields: [ownerId], references: [id])
  cancellationPolicy        CancellationPolicy?
  promotionLinks            PromotionBusiness[]
  members                   SalonMember[]
  trustSnapshot             SalonTrustSnapshot?
  userRoles                 UserRole[]
  ownedPromotions           Promotion[]                  @relation("PromotionOwner")
  vouchers                  Voucher[]
  serviceCatalog            BusinessService[]
  serviceCategories         ServiceCategory[]
  bookingRestrictedAt       DateTime?                    @map("booking_restricted_at")
  bookingRestrictionReason  String?                      @map("booking_restriction_reason")
  trustActions              TrustAction[]
  reviewEvents              BusinessReviewEvent[]
  documents                 BusinessDocument[]
  combos                    Combo[]
  attendances               StaffAttendance[]
  attendanceExceptions      AttendanceExceptionRequest[]
  attendanceQrTokens        AttendanceQrToken[]
  attendanceEvents          AttendanceEvent[]
  consultationTemplates     ConsultationFormTemplate[]
  consultationSubmissions   ConsultationSubmission[]
  consultationConsentEvents ConsentEvent[]
  sensitiveAccessEvents     SensitiveDataAccessEvent[]
  sensitiveBreakGlassGrants SensitiveBreakGlassGrant[]
  branchReviewRequests      BranchReviewRequest[]
  staffAvailabilities       StaffAvailability[]
  timesheets                Timesheet[]
  compensationRules         CompensationRule[]
  compensationEntries       CompensationEntry[]
  payRuns                   PayRun[]
  paymentPolicies           PaymentPolicy[]
  pricingSnapshots          PricingSnapshot[]
  paymentPolicySnapshots    PaymentPolicySnapshot[]
  paymentIntents            PaymentIntent[]
  paymentTransactions       PaymentTransaction[]
  financialLedgerEntries    FinancialLedgerEntry[]
  platformFeeEntries        PlatformFeeEntry[]
  platformFeeAdjustments    PlatformFeeAdjustment[]
  platformStatements        PlatformStatement[]
  treatmentPackages         TreatmentPackage[]
  packagePurchases          PackagePurchase[]
  invoiceRequests           InvoiceInformationRequest[]
  voucherScopes             VoucherBranchScope[]

  @@index([ownerId])
  @@index([status])
  @@index([name])
  @@map("businesses")
}

model Branch {
  id                        String                       @id @default(uuid())
  businessId                String                       @map("business_id")
  name                      String
  publicName                String?                      @map("public_name")
  description               String?
  addressLine               String?                      @map("address_line")
  districtId                String?                      @map("district_id")
  ward                      String?
  floor                     String?
  directions                String?
  latitude                  Decimal?                     @db.Decimal(9, 6)
  longitude                 Decimal?                     @db.Decimal(9, 6)
  phone                     String?
  email                     String?
  serviceMode               BranchServiceMode            @default(AT_LOCATION) @map("service_mode")
  sameLegalEntity           Boolean                      @default(true) @map("same_legal_entity")
  managerName               String?                      @map("manager_name")
  scheduledOpeningDate      DateTime?                    @map("scheduled_opening_date") @db.Date
  timezone                  String                       @default("Asia/Ho_Chi_Minh")
  bookingStartDate          DateTime?                    @map("booking_start_date") @db.Date
  serviceAreas              Json?                        @map("service_areas")
  serviceRadiusKm           Int?                         @map("service_radius_km")
  travelFee                 Decimal?                     @map("travel_fee") @db.Decimal(12, 2)
  excludedServiceAreas      Json?                        @map("excluded_service_areas")
  bookingConfirmationMode   BookingConfirmationMode      @default(MANUAL_CONFIRMATION) @map("booking_confirmation_mode")
  staffAssignmentMode       StaffAssignmentMode          @default(AUTO_ASSIGN_IF_ANY_STAFF) @map("staff_assignment_mode")
  pendingHoldMinutes        Int                          @default(30) @map("pending_hold_minutes")
  status                    BranchStatus                 @default(PENDING)
  reviewStatus              BranchReviewStatus           @default(DRAFT) @map("review_status")
  operationalStatus         BranchOperationalStatus      @default(INACTIVE) @map("operational_status")
  reviewNote                String?                      @map("review_note")
  submittedAt               DateTime?                    @map("submitted_at")
  reviewedAt                DateTime?                    @map("reviewed_at")
  publishedAt               DateTime?                    @map("published_at")
  createdAt                 DateTime                     @default(now()) @map("created_at")
  updatedAt                 DateTime                     @updatedAt @map("updated_at")
  deletedAt                 DateTime?                    @map("deleted_at")
  bookings                  Booking[]
  images                    BranchImage[]
  workingHours              BranchWorkingHour[]
  business                  Business                     @relation(fields: [businessId], references: [id])
  district                  District?                    @relation(fields: [districtId], references: [id])
  combos                    Combo[]
  promotionLinks            PromotionBranch[]
  recurringPlans            RecurringBookingPlan[]
  salonMembers              SalonMember[]
  services                  BranchServiceOffering[]
  staff                     StaffProfile[]
  userRoles                 UserRole[]
  holidays                  BranchHoliday[]
  specialDays               SpecialWorkingDay[]
  attendances               StaffAttendance[]
  attendanceExceptions      AttendanceExceptionRequest[]
  attendanceQrTokens        AttendanceQrToken[]
  attendanceEvents          AttendanceEvent[]
  trustActions              TrustAction[]
  consultationTemplates     ConsultationFormTemplate[]
  consultationSubmissions   ConsultationSubmission[]
  consultationConsentEvents ConsentEvent[]
  sensitiveAccessEvents     SensitiveDataAccessEvent[]
  sensitiveBreakGlassGrants SensitiveBreakGlassGrant[]
  onboardingProgress        BranchOnboardingProgress?
  bookingPolicy             BranchBookingPolicy?
  attendancePolicy          BranchAttendancePolicy?
  documents                 BranchDocument[]
  reviewRequests            BranchReviewRequest[]
  reviewEvents              BranchReviewEvent[]
  staffAssignments          StaffBranchAssignment[]
  scheduleVersions          StaffScheduleVersion[]
  scheduleChangeRequests    StaffScheduleChangeRequest[]
  staffAvailabilities       StaffAvailability[]
  timesheets                Timesheet[]
  compensationRules         CompensationRule[]
  compensationAssignments   CompensationAssignment[]
  compensationEntries       CompensationEntry[]
  paymentPolicies           PaymentPolicy[]
  pricingSnapshots          PricingSnapshot[]
  paymentPolicySnapshots    PaymentPolicySnapshot[]
  paymentIntents            PaymentIntent[]
  paymentTransactions       PaymentTransaction[]
  financialLedgerEntries    FinancialLedgerEntry[]
  platformFeeEntries        PlatformFeeEntry[]
  platformFeeAdjustments    PlatformFeeAdjustment[]
  treatmentPackages         TreatmentPackage[]
  packagePurchases          PackagePurchase[]
  invoiceRequests           InvoiceInformationRequest[]
  voucherBranchScopes       VoucherBranchScope[]

  @@index([businessId])
  @@index([districtId])
  @@index([status])
  @@index([reviewStatus])
  @@index([operationalStatus])
  @@index([status, deletedAt, createdAt])
  @@index([latitude, longitude])
  @@map("branches")
}

model BranchWorkingHour {
  id        String   @id @default(uuid())
  branchId  String   @map("branch_id")
  dayOfWeek Int      @map("day_of_week") @db.SmallInt
  openTime  DateTime @map("open_time") @db.Time(6)
  closeTime DateTime @map("close_time") @db.Time(6)
  isClosed  Boolean  @default(false) @map("is_closed")
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek])
  @@map("branch_working_hours")
}

model BranchOnboardingProgress {
  id             String   @id @default(uuid())
  branchId       String   @unique @map("branch_id")
  currentStep    Int      @default(1) @map("current_step")
  completedSteps Json     @default("[]") @map("completed_steps")
  draftData      Json?    @map("draft_data")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("branch_onboarding_progress")
}

model BranchBookingPolicy {
  id                   String    @id @default(uuid())
  branchId             String    @unique @map("branch_id")
  leadTimeMinutes      Int       @default(0) @map("lead_time_minutes")
  bookingHorizonDays   Int       @default(90) @map("booking_horizon_days")
  cancellationHours    Int       @default(24) @map("cancellation_hours")
  rescheduleHours      Int       @default(12) @map("reschedule_hours")
  noShowHandling       String?   @map("no_show_handling")
  earlyCheckInMinutes  Int       @default(0) @map("early_check_in_minutes")
  gracePeriodMinutes   Int       @default(10) @map("grace_period_minutes")
  allowWalkIn          Boolean   @default(true) @map("allow_walk_in")
  allowCounterBooking  Boolean   @default(true) @map("allow_counter_booking")
  defaultBufferMinutes Int       @default(0) @map("default_buffer_minutes")
  overbookingEnabled   Boolean   @default(false) @map("overbooking_enabled")
  maxOverbookedSlots   Int       @default(0) @map("max_overbooked_slots")
  depositPolicy        Json?     @map("deposit_policy")
  confirmedAt          DateTime? @map("confirmed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  branch               Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("branch_booking_policies")
}

model OverbookingOverride {
  id          String   @id @default(uuid())
  bookingId   String   @unique @map("booking_id")
  branchId    String   @map("branch_id")
  actorId     String   @map("actor_id")
  reason      String
  policyLimit Int      @map("policy_limit")
  startAt     DateTime @map("start_at")
  endAt       DateTime @map("end_at")
  createdAt   DateTime @default(now()) @map("created_at")
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([branchId, startAt, endAt])
  @@map("overbooking_overrides")
}

model BranchAttendancePolicy {
  id                      String    @id @default(uuid())
  branchId                String    @unique @map("branch_id")
  useQr                   Boolean   @default(true) @map("use_qr")
