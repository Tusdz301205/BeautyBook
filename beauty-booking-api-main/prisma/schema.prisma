  @@index([businessId, createdAt])
  @@index([branchId, createdAt])
  @@map("payment_intents")
}

/// Append-only financial transaction. A verified row is never edited or
/// deleted; corrections create a REVERSED row and a replacement transaction.
model PaymentTransaction {
  id                   String                   @id @default(uuid())
  intentId             String?                  @map("intent_id")
  paymentId            String?                  @map("payment_id")
  bookingId            String?                  @map("booking_id")
  packagePurchaseId    String?                  @map("package_purchase_id")
  packageInstallmentId String?                  @map("package_installment_id")
  businessId           String                   @map("business_id")
  branchId             String                   @map("branch_id")
  amount               Decimal                  @db.Decimal(12, 2)
  currency             String                   @default("VND")
  method               PaymentMethod
  provider             String
  status               PaymentTransactionStatus @default(PENDING)
  transactionRef       String?                  @map("transaction_ref")
  idempotencyKey       String                   @unique @map("idempotency_key")
  providerEventId      String?                  @unique @map("provider_event_id")
  evidence             Json?
  verifiedBy           String?                  @map("verified_by")
  verifiedAt           DateTime?                @map("verified_at")
  reversalOfId         String?                  @unique @map("reversal_of_id")
  failureReason        String?                  @map("failure_reason")
  createdAt            DateTime                 @default(now()) @map("created_at")
  intent               PaymentIntent?           @relation(fields: [intentId], references: [id], onDelete: SetNull)
  payment              Payment?                 @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  booking              Booking?                 @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  packagePurchase      PackagePurchase?         @relation(fields: [packagePurchaseId], references: [id], onDelete: Restrict)
  packageInstallment   PackageInstallment?      @relation(fields: [packageInstallmentId], references: [id], onDelete: Restrict)
  business             Business                 @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch               Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  reversalOf           PaymentTransaction?      @relation("PaymentTransactionReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy           PaymentTransaction?      @relation("PaymentTransactionReversal")
  ledgerEntries        FinancialLedgerEntry[]

  @@index([bookingId, status])
  @@index([packagePurchaseId, status])
  @@index([businessId, createdAt])
  @@index([branchId, createdAt])
  @@map("payment_transactions")
}

/// Accounting evidence. The migration installs a database trigger which
/// rejects UPDATE/DELETE so corrections must be posted as new entries.
model FinancialLedgerEntry {
  id                   String              @id @default(uuid())
  businessId           String              @map("business_id")
  branchId             String              @map("branch_id")
  bookingId            String?             @map("booking_id")
  paymentId            String?             @map("payment_id")
  paymentTransactionId String?             @map("payment_transaction_id")
  refundId             String?             @map("refund_id")
  type                 FinancialLedgerType
  direction            LedgerDirection
  amount               Decimal             @db.Decimal(12, 2)
  currency             String              @default("VND")
  sourceType           String              @map("source_type")
  sourceId             String              @map("source_id")
  idempotencyKey       String              @unique @map("idempotency_key")
  actorId              String?             @map("actor_id")
  correlationId        String?             @map("correlation_id")
  metadata             Json?
  occurredAt           DateTime            @default(now()) @map("occurred_at")
  business             Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch               Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  booking              Booking?            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payment              Payment?            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)
  refund               RefundRequest?      @relation(fields: [refundId], references: [id], onDelete: Restrict)

  @@index([businessId, occurredAt])
  @@index([branchId, occurredAt])
  @@index([bookingId, occurredAt])
  @@index([sourceType, sourceId])
  @@map("financial_ledger_entries")
}

model RefundAllocation {
