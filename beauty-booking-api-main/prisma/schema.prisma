/// Transactional hand-off between a committed business operation and the
/// in-app notification projection. The unique dedupe key makes worker retries
/// safe and keeps critical impact notifications from being lost or duplicated.
model NotificationOutbox {
  id               String                   @id @default(uuid())
  userId           String                   @map("user_id")
  type             NotificationType
  severity         NotificationSeverity     @default(INFO)
  title            String
  body             String?
  targetType       String?                  @map("target_type")
  targetId         String?                  @map("target_id")
  actionUrl        String?                  @map("action_url")
  metadata         Json?
  relatedBookingId String?                  @map("related_booking_id")
  dedupeKey        String                   @unique @map("dedupe_key")
  status           NotificationOutboxStatus @default(PENDING)
  attempts         Int                      @default(0)
  availableAt      DateTime                 @default(now()) @map("available_at")
  lastError        String?                  @map("last_error")
  sentAt           DateTime?                @map("sent_at")
  notificationId   String?                  @unique @map("notification_id")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  user             User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  relatedBooking   Booking?                 @relation(fields: [relatedBookingId], references: [id], onDelete: Restrict)
  notification     Notification?            @relation(fields: [notificationId], references: [id], onDelete: Restrict)

  @@index([status, availableAt])
  @@index([userId, createdAt])
  @@map("notification_outbox")
}

