model Booking {
  id                        String                      @id @default(uuid())
  customerId                String                      @map("customer_id")
  branchId                  String                      @map("branch_id")
  recurringPlanId           String?                     @map("recurring_plan_id")
  bookingCode               String                      @unique @map("booking_code")
  appointmentDate           DateTime                    @map("appointment_date") @db.Date
  appointmentStartTime      DateTime                    @map("appointment_start_time") @db.Time(6)
  appointmentEndTime        DateTime                    @map("appointment_end_time") @db.Time(6)
  status                    BookingStatus               @default(PENDING)
  source                    BookingSource               @default(ONLINE_WEB)
  pendingExpiresAt          DateTime?                   @map("pending_expires_at")
  totalAmount               Decimal                     @map("total_amount") @db.Decimal(12, 2)
  note                      String?
  cancelReason              String?                     @map("cancel_reason")
  cancelledAt               DateTime?                   @map("cancelled_at")
  cancelledBy               String?                     @map("cancelled_by")
  createdAt                 DateTime                    @default(now()) @map("created_at")
  updatedAt                 DateTime                    @updatedAt @map("updated_at")
  deletedAt                 DateTime?                   @map("deleted_at")
  cancelledByType           CancelledByType?            @map("cancelled_by_type")
  cancellationFeeAmount     Decimal?                    @map("cancellation_fee_amount") @db.Decimal(12, 2)
  finalAmount               Decimal?                    @map("final_amount") @db.Decimal(12, 2)
  voucherDiscountAmount     Decimal?                    @map("voucher_discount_amount") @db.Decimal(12, 2)
  voucherId                 String?                     @map("voucher_id")
  sensitiveDataConsent      Boolean                     @default(false) @map("sensitive_data_consent")
  changeRequests            AppointmentChangeRequest[]
  healthRecords             BookingHealthRecord[]
  bookingServices           BookingService[]
  statusHistory             BookingStatusHistory[]
  branch                    Branch                      @relation(fields: [branchId], references: [id])
  cancelledByUser           User?                       @relation("BookingCancelledBy", fields: [cancelledBy], references: [id])
  customer                  CustomerProfile             @relation(fields: [customerId], references: [id])
  recurringPlan             RecurringBookingPlan?       @relation(fields: [recurringPlanId], references: [id])
  voucher                   Voucher?                    @relation(fields: [voucherId], references: [id])
  notifications             Notification[]
  notificationOutboxes      NotificationOutbox[]
  payments                  Payment[]
  review                    Review?
  contact                   BookingContact?
  consultationSubmissions   ConsultationSubmission[]
  consultationConsentEvents ConsentEvent[]
  sensitiveAccessEvents     SensitiveDataAccessEvent[]
  sensitiveBreakGlassGrants SensitiveBreakGlassGrant[]
  pricingSnapshot           PricingSnapshot?
  paymentPolicySnapshot     PaymentPolicySnapshot?
  paymentIntents            PaymentIntent[]
  paymentTransactions       PaymentTransaction[]
  financialLedgerEntries    FinancialLedgerEntry[]
  platformFeeEntry          PlatformFeeEntry?
  packageEntitlements       PackageSessionEntitlement[]
  overbookingOverride       OverbookingOverride?
  invoiceRequests           InvoiceInformationRequest[]

  @@index([customerId])
  @@index([branchId])
  @@index([appointmentDate])
  @@index([status])
  @@index([status, pendingExpiresAt])
  @@map("bookings")
}

model BookingService {
  id                  String                     @id @default(uuid())
  bookingId           String                     @map("booking_id")
  serviceId           String                     @map("service_id")
