  canonicalService    CanonicalService?          @relation(fields: [canonicalServiceId], references: [id], onDelete: Restrict)
  staff               StaffProfile?              @relation(fields: [staffId], references: [id])
  reviewRating        ReviewServiceRating?
  compensationEntries CompensationEntry[]
  refundAllocations   RefundAllocation[]
  packageEntitlement  PackageSessionEntitlement?

