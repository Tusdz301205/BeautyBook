# --- Database ---
DATABASE_URL="postgresql://postgres:123@localhost:5432/glowbook_db?schema=public"
DIRECT_URL="postgresql://postgres:123@localhost:5432/glowbook_db?schema=public"

# --- Server ---
PORT=3000
NODE_ENV=development
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
BOOKING_TIME_ZONE="Asia/Ho_Chi_Minh"
IDEMPOTENCY_TTL_SECONDS=86400
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT="1mb"
FORM_BODY_LIMIT="1mb"
UPLOAD_DIR="./uploads"

# --- JWT (NFR-012: access 15m, refresh 30d) ---
JWT_SECRET="change-me-in-production-please-use-32+chars"
JWT_REFRESH_SECRET="change-me-in-production-please-use-32+chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# --- Email (Gmail SMTP) ---
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="BeautyBook <no-reply@beautybook.vn>"

# --- Frontend URL (for email links) ---
FRONTEND_URL="http://localhost:5173"

# --- Distributed session revocation ---
REDIS_URL="redis://localhost:6379"

# --- Sensitive consultation and privacy exports ---
# Generate out-of-band: openssl rand -base64 32
# Never reuse JWT secrets and never commit the real key.
SENSITIVE_DATA_ENCRYPTION_KEY=""
SENSITIVE_DATA_KEY_VERSION="v1"
PRIVACY_EXPORT_TTL_MINUTES=15
