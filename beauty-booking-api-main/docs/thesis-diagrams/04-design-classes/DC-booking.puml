hide circle
hide empty members
top to bottom direction
class "**BookingsController**" as BookingsController {
  -bookingsService: BookingsService
  -prisma: PrismaService
  --
  +create(body: CreateBookingDto, user: AuthUser)
  +getAvailableSlots(...)
  +updateBookingItem(...)
}
class "**BookingsService**" as BookingsService {
  -prisma: PrismaService
  --
  +updateStatus(...)
  +create(data: ...)
  +getAvailableSlots(params: ...)
}
class "**PrismaService**" as PrismaService {
  --
  +onModuleInit()
  +onModuleDestroy()
}
BookingsController ..> BookingsService : inject
BookingsController ..> PrismaService : inject
BookingsService ..> PrismaService : inject
@enduml
