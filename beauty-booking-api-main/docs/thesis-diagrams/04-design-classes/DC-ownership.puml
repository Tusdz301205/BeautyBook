hide circle
hide empty members
top to bottom direction
class "**OwnershipController**" as OwnershipController {
  -ownership: OwnershipService
  -prisma: PrismaService
  --
  +create(body: any, user: AuthUser)
  +pendingForMe(user: AuthUser)
  +platformPending()
}
class "**OwnershipService**" as OwnershipService {
  -prisma: PrismaService
  -cipher: SensitiveDataCipherService
  --
  +create(...)
  +accept(transferId: string, userId: string)
  +execute(transferId: string, actorId: string)
}
class "**SensitiveDataCipherService**" as SensitiveDataCipherService {
  --
  +encrypt(value: unknown, maxBytes?): EncryptedValue
  +decrypt<T>(value: EncryptedValue): T
}
class "**PrismaService**" as PrismaService {
  --
  +onModuleInit()
  +onModuleDestroy()
}
OwnershipController ..> OwnershipService : inject
OwnershipController ..> PrismaService : inject
OwnershipService ..> PrismaService : inject
OwnershipService ..> SensitiveDataCipherService : inject
@enduml
