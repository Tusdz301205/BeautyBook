@startuml AC-identity
' Lớp khái niệm BCE; operation là trách nhiệm phân tích, không tuyên bố tồn tại class cùng tên trong code.
skinparam backgroundColor white
skinparam defaultFontName Times New Roman
skinparam defaultFontSize 17
skinparam shadowing false
skinparam roundcorner 2
skinparam linetype ortho
skinparam nodesep 44
skinparam ranksep 58
skinparam ArrowColor #444444
skinparam ArrowFontColor #333333
skinparam ArrowFontSize 14
skinparam classAttributeIconSize 0
skinparam stereotypeCBackgroundColor white
skinparam stereotypeIBackgroundColor white
skinparam classBackgroundColor white
skinparam classBorderColor #333333
skinparam classFontColor #111111
skinparam classFontStyle bold
skinparam classAttributeFontStyle plain
skinparam entityFontStyle bold
skinparam usecaseBackgroundColor #fffde7
skinparam usecaseBorderColor #773b4a
skinparam usecaseFontColor black
skinparam actorBorderColor #773b4a
skinparam actorBackgroundColor white
skinparam actorFontColor black
skinparam actorStyle stickman
hide circle
hide empty members
left to right direction
class "**Kênh tài khoản**" as KenhTaiKhoan <<boundary>> {
  phạm vi tương tác
  --
  tiếp nhận yêu cầu()
}
class "**Bảo vệ danh tính**" as BaoVeDanhTinh <<control>> {
  phạm vi tương tác
  --
  kiểm tra điều kiện()
}
class "**Tài khoản**" as TaiKhoan <<entity>> {
  định danh
  trạng thái
  --
  kiểm tra truy cập()
}
class "**Phiên truy cập**" as PhienTruyCap <<entity>> {
  mã
  trạng thái
  --
  ghi nhận kết quả()
}
class "**Yêu cầu dữ liệu**" as YeuCauDuLieu <<entity>> {
  mã
  trạng thái
  --
  ghi nhận kết quả()
}
KenhTaiKhoan ..> BaoVeDanhTinh
BaoVeDanhTinh ..> TaiKhoan
BaoVeDanhTinh ..> PhienTruyCap
BaoVeDanhTinh ..> YeuCauDuLieu
@enduml
