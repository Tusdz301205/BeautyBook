@startuml ERD-booking
' Miền dữ liệu hiện hành hoặc hỗ trợ. Quan hệ xuyên miền xem catalogue đầy đủ. PK/FK/UQ; dấu * = NOT NULL. Hình chọn tối đa 7 cột và 6 FK; từ điển/relationship-catalog chứa đầy đủ. Tên FK nằm trong bảng quan hệ dưới hình HTML.
skinparam backgroundColor white
skinparam defaultFontName Times New Roman
skinparam defaultFontSize 17
skinparam shadowing false
skinparam roundcorner 2
skinparam linetype ortho
skinparam nodesep 44
skinparam ranksep 58
skinparam ArrowColor #444444
skinparam ArrowFontColor #333333
skinparam ArrowFontSize 14
skinparam classAttributeIconSize 0
skinparam stereotypeCBackgroundColor white
skinparam stereotypeIBackgroundColor white
skinparam classBackgroundColor white
skinparam classBorderColor #333333
skinparam classFontColor #111111
skinparam classFontStyle bold
skinparam classAttributeFontStyle plain
skinparam entityFontStyle bold
skinparam usecaseBackgroundColor #fffde7
skinparam usecaseBorderColor #773b4a
skinparam usecaseFontColor black
skinparam actorBorderColor #773b4a
skinparam actorBackgroundColor white
skinparam actorFontColor black
skinparam actorStyle stickman
hide circle
hide empty members
left to right direction
entity "**Booking**\n(bookings)" as Booking {
  * id: String <<PK>>
  * customerId: String <<FK>>
  * branchId: String <<FK>>
  recurringPlanId: String? <<FK>>
  cancelledBy: String? <<FK>>
  voucherId: String? <<FK>>
  * bookingCode: String <<UQ>>
  ... 18 cot: xem tu dien
}
entity "**BookingService**\n(booking_services)" as BookingService {
  * id: String <<PK>>
  * bookingId: String <<FK>>
  * serviceId: String <<FK>>
  * businessServiceId: String <<FK>>
  canonicalServiceId: String? <<FK>>
  comboId: String? <<FK>>
  staffId: String? <<FK>>
  ... 14 cot: xem tu dien
}
entity "**BookingContact**\n(booking_contacts)" as BookingContact {
  * id: String <<PK>>
  * bookingId: String <<FK>> <<UQ>>
  * fullName: String 
  phone: String? 
  email: String? 
  * createdAt: DateTime 
}
entity "**BookingStatusHistory**\n(booking_status_histories)" as BookingStatusHistory {
  * id: String <<PK>>
  * bookingId: String <<FK>>
  changedBy: String? <<FK>>
  * status: BookingStatus 
  note: String? 
  * createdAt: DateTime 
}
entity "**BookingServiceAdjustment**\n(booking_service_adjustments)" as BookingServiceAdjustment {
  * id: String <<PK>>
  * bookingServiceId: String <<FK>>
  * bookingId: String <<FK>>
  * actorId: String <<FK>>
  * action: BookingItemAction 
  * reason: String 
  * beforeSnapshot: Json 
  ... 4 cot: xem tu dien
}
Booking ||--o| BookingContact
Booking ||--o{ BookingService
Booking ||--o{ BookingStatusHistory
BookingService ||--o{ BookingServiceAdjustment
Booking ||--o{ BookingServiceAdjustment

@enduml
