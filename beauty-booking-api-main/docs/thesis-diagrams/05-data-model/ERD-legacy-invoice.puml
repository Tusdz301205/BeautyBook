@startuml ERD-legacy-invoice
' Phụ lục vật lý di sản, không là chức năng đang cung cấp. PK/FK/UQ; dấu * = NOT NULL. Hình chọn tối đa 7 cột và 6 FK; từ điển/relationship-catalog chứa đầy đủ. Tên FK nằm trong bảng quan hệ dưới hình HTML.
skinparam backgroundColor white
skinparam defaultFontName Times New Roman
skinparam defaultFontSize 17
skinparam shadowing false
skinparam roundcorner 2
skinparam linetype ortho
skinparam nodesep 44
skinparam ranksep 58
skinparam ArrowColor #444444
skinparam ArrowFontColor #333333
skinparam ArrowFontSize 14
skinparam classAttributeIconSize 0
skinparam stereotypeCBackgroundColor white
skinparam stereotypeIBackgroundColor white
skinparam classBackgroundColor white
skinparam classBorderColor #333333
skinparam classFontColor #111111
skinparam classFontStyle bold
skinparam classAttributeFontStyle plain
skinparam entityFontStyle bold
skinparam usecaseBackgroundColor #fffde7
skinparam usecaseBorderColor #773b4a
skinparam usecaseFontColor black
skinparam actorBorderColor #773b4a
skinparam actorBackgroundColor white
skinparam actorFontColor black
skinparam actorStyle stickman
hide circle
hide empty members
left to right direction
entity "**Invoice**\n(invoices)" as Invoice {
  * id: String <<PK>>
  * businessId: String <<FK>>
  * branchId: String <<FK>>
  bookingId: String? <<FK>>
  paymentId: String? <<FK>>
  replacesInvoiceId: String? <<FK>> <<UQ>>
  * createdBy: String <<FK>>
  ... 16 cot: xem tu dien
}
entity "**InvoiceInformationRequest**\n(invoice_information_requests)" as InvoiceInformationRequest {
  * id: String <<PK>>
  * bookingId: String <<FK>>
  * customerId: String <<FK>>
  * businessId: String <<FK>>
  * branchId: String <<FK>>
  invoiceId: String? <<FK>> <<UQ>>
  * status: InvoiceRequestStatus 
  ... 9 cot: xem tu dien
}
entity "**InvoiceLine**\n(invoice_lines)" as InvoiceLine {
  * id: String <<PK>>
  * invoiceId: String <<FK>>
  bookingServiceId: String? <<FK>>
  * description: String 
  * quantity: Int 
  * unitPrice: Decimal 
  * discountAmount: Decimal 
  ... 4 cot: xem tu dien
}
entity "**InvoiceEvent**\n(invoice_events)" as InvoiceEvent {
  * id: String <<PK>>
  * invoiceId: String <<FK>>
  * actorId: String <<FK>>
  * action: String 
  reason: String? 
  * snapshot: Json 
  * createdAt: DateTime 
}
Invoice |o--o| Invoice
Invoice |o--o| InvoiceInformationRequest
Invoice ||--o{ InvoiceLine
Invoice ||--o{ InvoiceEvent

@enduml
