@startuml ERD-package
' Miền dữ liệu hiện hành hoặc hỗ trợ. Quan hệ xuyên miền xem catalogue đầy đủ. PK/FK/UQ; dấu * = NOT NULL. Hình chọn tối đa 7 cột và 6 FK; từ điển/relationship-catalog chứa đầy đủ. Tên FK nằm trong bảng quan hệ dưới hình HTML.
skinparam backgroundColor white
skinparam defaultFontName Times New Roman
skinparam defaultFontSize 17
skinparam shadowing false
skinparam roundcorner 2
skinparam linetype ortho
skinparam nodesep 44
skinparam ranksep 58
skinparam ArrowColor #444444
skinparam ArrowFontColor #333333
skinparam ArrowFontSize 14
skinparam classAttributeIconSize 0
skinparam stereotypeCBackgroundColor white
skinparam stereotypeIBackgroundColor white
skinparam classBackgroundColor white
skinparam classBorderColor #333333
skinparam classFontColor #111111
skinparam classFontStyle bold
skinparam classAttributeFontStyle plain
skinparam entityFontStyle bold
skinparam usecaseBackgroundColor #fffde7
skinparam usecaseBorderColor #773b4a
skinparam usecaseFontColor black
skinparam actorBorderColor #773b4a
skinparam actorBackgroundColor white
skinparam actorFontColor black
skinparam actorStyle stickman
hide circle
hide empty members
left to right direction
entity "**TreatmentPackage**\n(treatment_packages)" as TreatmentPackage {
  * id: String <<PK>>
  * businessId: String <<FK>>
  branchId: String? <<FK>>
  * name: String 
  description: String? 
  * totalPrice: Decimal 
  * currency: String 
  ... 5 cot: xem tu dien
}
entity "**PackagePurchase**\n(package_purchases)" as PackagePurchase {
  * id: String <<PK>>
  * packageId: String <<FK>>
  * customerId: String <<FK>>
  * businessId: String <<FK>>
  branchId: String? <<FK>>
  * totalAmount: Decimal 
  * paidAmount: Decimal 
  ... 5 cot: xem tu dien
}
entity "**PackageInstallment**\n(package_installments)" as PackageInstallment {
  * id: String <<PK>>
  * purchaseId: String <<FK>>
  * sequence: Int 
  * dueAt: DateTime 
  * amount: Decimal 
  * status: PackageInstallmentStatus 
  paymentIntentId: String? 
  ... 1 cot: xem tu dien
}
entity "**PackageSessionEntitlement**\n(package_session_entitlements)" as PackageSessionEntitlement {
  * id: String <<PK>>
  * purchaseId: String <<FK>>
  bookingId: String? <<FK>>
  redeemedBookingServiceId: String? <<FK>> <<UQ>>
  * sequence: Int 
  * status: PackageEntitlementStatus 
  reservedAt: DateTime? 
  ... 1 cot: xem tu dien
}
TreatmentPackage ||--o{ PackagePurchase
PackagePurchase ||--o{ PackageInstallment
PackagePurchase ||--o{ PackageSessionEntitlement

@enduml
