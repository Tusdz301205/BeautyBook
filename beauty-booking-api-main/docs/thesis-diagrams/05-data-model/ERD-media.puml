@startuml ERD-media
' Miền dữ liệu hiện hành hoặc hỗ trợ. Quan hệ xuyên miền xem catalogue đầy đủ. PK/FK/UQ; dấu * = NOT NULL. Hình chọn tối đa 7 cột và 6 FK; từ điển/relationship-catalog chứa đầy đủ. Tên FK nằm trong bảng quan hệ dưới hình HTML.
skinparam backgroundColor white
skinparam defaultFontName Times New Roman
skinparam defaultFontSize 17
skinparam shadowing false
skinparam roundcorner 2
skinparam linetype ortho
skinparam nodesep 44
skinparam ranksep 58
skinparam ArrowColor #444444
skinparam ArrowFontColor #333333
skinparam ArrowFontSize 14
skinparam classAttributeIconSize 0
skinparam stereotypeCBackgroundColor white
skinparam stereotypeIBackgroundColor white
skinparam classBackgroundColor white
skinparam classBorderColor #333333
skinparam classFontColor #111111
skinparam classFontStyle bold
skinparam classAttributeFontStyle plain
skinparam entityFontStyle bold
skinparam usecaseBackgroundColor #fffde7
skinparam usecaseBorderColor #773b4a
skinparam usecaseFontColor black
skinparam actorBorderColor #773b4a
skinparam actorBackgroundColor white
skinparam actorFontColor black
skinparam actorStyle stickman
hide circle
hide empty members
left to right direction
entity "**MediaFile**\n(media_files)" as MediaFile {
  * id: String <<PK>>
  uploadedBy: String? <<FK>>
  * url: String 
  storageKey: String? <<UQ>>
  originalName: String? 
  safeName: String? 
  mimeType: String? 
  ... 10 cot: xem tu dien
}
entity "**BusinessImage**\n(business_images)" as BusinessImage {
  * id: String <<PK>>
  * businessId: String <<FK>>
  * mediaId: String <<FK>>
  * isCover: Boolean 
  * sortOrder: Int 
  * createdAt: DateTime 
}
entity "**BranchImage**\n(branch_images)" as BranchImage {
  * id: String <<PK>>
  * branchId: String <<FK>>
  * mediaId: String <<FK>>
  * isCover: Boolean 
  * sortOrder: Int 
  * createdAt: DateTime 
}
entity "**ServiceImage**\n(service_images)" as ServiceImage {
  * id: String <<PK>>
  * serviceId: String <<FK>>
  * mediaId: String <<FK>>
  * sortOrder: Int 
  * createdAt: DateTime 
}
entity "**StaffImage**\n(staff_images)" as StaffImage {
  * id: String <<PK>>
  * staffId: String <<FK>>
  * mediaId: String <<FK>>
  * sortOrder: Int 
  * createdAt: DateTime 
}
MediaFile ||--o{ BusinessImage
MediaFile ||--o{ BranchImage
MediaFile ||--o{ ServiceImage
MediaFile ||--o{ StaffImage

@enduml
