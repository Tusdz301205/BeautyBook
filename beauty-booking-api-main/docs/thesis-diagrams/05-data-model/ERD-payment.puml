@startuml ERD-payment
' Miền dữ liệu hiện hành hoặc hỗ trợ. Quan hệ xuyên miền xem catalogue đầy đủ. PK/FK/UQ; dấu * = NOT NULL. Hình chọn tối đa 7 cột và 6 FK; từ điển/relationship-catalog chứa đầy đủ. Tên FK nằm trong bảng quan hệ dưới hình HTML.
skinparam backgroundColor white
skinparam defaultFontName Times New Roman
skinparam defaultFontSize 17
skinparam shadowing false
skinparam roundcorner 2
skinparam linetype ortho
skinparam nodesep 44
skinparam ranksep 58
skinparam ArrowColor #444444
skinparam ArrowFontColor #333333
skinparam ArrowFontSize 14
skinparam classAttributeIconSize 0
skinparam stereotypeCBackgroundColor white
skinparam stereotypeIBackgroundColor white
skinparam classBackgroundColor white
skinparam classBorderColor #333333
skinparam classFontColor #111111
skinparam classFontStyle bold
skinparam classAttributeFontStyle plain
skinparam entityFontStyle bold
skinparam usecaseBackgroundColor #fffde7
skinparam usecaseBorderColor #773b4a
skinparam usecaseFontColor black
skinparam actorBorderColor #773b4a
skinparam actorBackgroundColor white
skinparam actorFontColor black
skinparam actorStyle stickman
hide circle
hide empty members
left to right direction
entity "**Payment**\n(payments)" as Payment {
  * id: String <<PK>>
  * bookingId: String <<FK>>
  * amount: Decimal 
  * method: PaymentMethod 
  * status: PaymentStatus 
  transactionRef: String? 
  paidAt: DateTime? 
  ... 2 cot: xem tu dien
}
entity "**PaymentIntent**\n(payment_intents)" as PaymentIntent {
  * id: String <<PK>>
  bookingId: String? <<FK>>
  packagePurchaseId: String? <<FK>>
  packageInstallmentId: String? <<FK>>
  * businessId: String <<FK>>
  * branchId: String <<FK>>
  * amount: Decimal 
  ... 10 cot: xem tu dien
}
entity "**PaymentTransaction**\n(payment_transactions)" as PaymentTransaction {
  * id: String <<PK>>
  intentId: String? <<FK>>
  paymentId: String? <<FK>>
  bookingId: String? <<FK>>
  packagePurchaseId: String? <<FK>>
  packageInstallmentId: String? <<FK>>
  * businessId: String <<FK>>
  ... 15 cot: xem tu dien
}
entity "**PricingSnapshot**\n(pricing_snapshots)" as PricingSnapshot {
  * id: String <<PK>>
  * bookingId: String <<FK>> <<UQ>>
  * businessId: String <<FK>>
  * branchId: String <<FK>>
  * currency: String 
  * subtotalAmount: Decimal 
  * discountAmount: Decimal 
  ... 3 cot: xem tu dien
}
entity "**PaymentPolicySnapshot**\n(payment_policy_snapshots)" as PaymentPolicySnapshot {
  * id: String <<PK>>
  * bookingId: String <<FK>> <<UQ>>
  * businessId: String <<FK>>
  * branchId: String <<FK>>
  paymentPolicyId: String? <<FK>>
  policyVersion: Int? 
  * depositType: DepositType 
  ... 5 cot: xem tu dien
}
PaymentIntent |o--o{ PaymentTransaction
Payment |o--o{ PaymentTransaction
PaymentTransaction |o--o| PaymentTransaction

@enduml
