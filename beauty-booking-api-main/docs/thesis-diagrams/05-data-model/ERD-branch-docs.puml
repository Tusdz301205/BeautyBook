@startuml ERD-branch-docs
' Miền dữ liệu hiện hành hoặc hỗ trợ. Quan hệ xuyên miền xem catalogue đầy đủ. PK/FK/UQ; dấu * = NOT NULL. Hình chọn tối đa 7 cột và 6 FK; từ điển/relationship-catalog chứa đầy đủ. Tên FK nằm trong bảng quan hệ dưới hình HTML.
skinparam backgroundColor white
skinparam defaultFontName Times New Roman
skinparam defaultFontSize 17
skinparam shadowing false
skinparam roundcorner 2
skinparam linetype ortho
skinparam nodesep 44
skinparam ranksep 58
skinparam ArrowColor #444444
skinparam ArrowFontColor #333333
skinparam ArrowFontSize 14
skinparam classAttributeIconSize 0
skinparam stereotypeCBackgroundColor white
skinparam stereotypeIBackgroundColor white
skinparam classBackgroundColor white
skinparam classBorderColor #333333
skinparam classFontColor #111111
skinparam classFontStyle bold
skinparam classAttributeFontStyle plain
skinparam entityFontStyle bold
skinparam usecaseBackgroundColor #fffde7
skinparam usecaseBorderColor #773b4a
skinparam usecaseFontColor black
skinparam actorBorderColor #773b4a
skinparam actorBackgroundColor white
skinparam actorFontColor black
skinparam actorStyle stickman
hide circle
hide empty members
left to right direction
entity "**BranchDocument**\n(branch_documents)" as BranchDocument {
  * id: String <<PK>>
  * branchId: String <<FK>>
  * documentType: BranchDocumentType 
  documentNumber: String? 
  issuedAt: DateTime? 
  expiresAt: DateTime? 
  * status: BranchDocumentStatus 
  ... 3 cot: xem tu dien
}
entity "**BranchDocumentVersion**\n(branch_document_versions)" as BranchDocumentVersion {
  * id: String <<PK>>
  * documentId: String <<FK>>
  * mediaId: String <<FK>>
  * createdBy: String <<FK>>
  * version: Int 
  * documentName: String 
  note: String? 
  ... 1 cot: xem tu dien
}
entity "**BranchReviewRequest**\n(branch_review_requests)" as BranchReviewRequest {
  * id: String <<PK>>
  * branchId: String <<FK>>
  * requestedBy: String <<FK>>
  assignedTo: String? <<FK>>
  * status: BranchReviewStatus 
  * profileSnapshot: Json 
  documentSnapshot: Json? 
  ... 4 cot: xem tu dien
}
entity "**BranchReviewEvent**\n(branch_review_events)" as BranchReviewEvent {
  * id: String <<PK>>
  * branchId: String <<FK>>
  actorId: String? <<FK>>
  * action: String 
  fromStatus: BranchReviewStatus? 
  * toStatus: BranchReviewStatus 
  reason: String? 
  ... 3 cot: xem tu dien
}
BranchDocument ||--o{ BranchDocumentVersion

@enduml
